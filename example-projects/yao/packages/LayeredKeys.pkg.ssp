package LayeredKeys {
    /*
     * The multi-layer version of Keys: the same state and the same oracles, only
     * that every wire is addressed by the pair (layer, wire) instead of by a bare
     * wire index.  Wire layers are numbered 1..(d + 1); the gates of gate layer
     * `layer` read wire layer `layer` and write wire layer `layer + 1`.
     */
    params {
        n: Integer,
    }

    state {
        WireKey: Table((Integer, Integer), Table(Bool, Bits(n))),
        ActiveBit: Table((Integer, Integer), Bool),
    }


    oracle SetActiveBit(layer: Integer, wire: Integer, bit: Bool) {
        assert (ActiveBit[(layer, wire)] == None);
        ActiveBit[(layer, wire)] <- Some(bit);
        return;
    }

    oracle GetActiveBit(layer: Integer, wire: Integer) -> Bool {
        assert (ActiveBit[(layer, wire)] != None);
        b <- Unwrap(ActiveBit[(layer, wire)]);
        return b;
    }

    oracle GenerateWireKeys(layer: Integer, wire: Integer) {
        assert (ActiveBit[(layer, wire)] != None);
        if (WireKey[(layer, wire)] == None) {
            W <- new Table(Bool, Bits(n));
            k1 <-$ Bits(n) sample-name key_true;
            W[true] <- Some(k1);
            k0 <-$ Bits(n) sample-name key_false;
            W[false] <- Some(k0);
            WireKey[(layer, wire)] <- Some(W);
        }
    }

    oracle GetWireKeys(layer: Integer, wire: Integer) -> Table(Bool, Bits(n)) {
        assert (ActiveBit[(layer, wire)] != None);
        W <- Unwrap(WireKey[(layer, wire)]);
        return W;
    }

    oracle GetActiveWireKey(layer: Integer, wire: Integer) -> Bits(n) {
        W <- Unwrap(WireKey[(layer, wire)]);
        b <- Unwrap(ActiveBit[(layer, wire)]);
        k <- Unwrap(W[b]);
        return k;
    }

    oracle GetInactiveWireKey(layer: Integer, wire: Integer) -> Bits(n) {
        W <- Unwrap(WireKey[(layer, wire)]);
        b <- Unwrap(ActiveBit[(layer, wire)]);
        k <- Unwrap(W[not b]);
        return k;
    }
}
