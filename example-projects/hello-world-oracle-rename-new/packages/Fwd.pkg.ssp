package Fwd {
    params {
        n: Integer,
    }

    state {
        ctr: Integer,
    }

    import oracles {
        ChangeNameUsefulOracle(dummy: Integer) -> (Integer,Bits(n)),
        AnotherUsefulOracle(dummy: Integer) -> (Integer,Bits(n)),
    }

    oracle UsefulOracle(dummy: Integer) -> (Integer,Bits(n))  {
        y <- invoke ChangeNameUsefulOracle(dummy);
        z <- invoke AnotherUsefulOracle(dummy);
        return z;
    }

    oracle UselessOracle(x: Integer) -> Integer  {
        assert (x == 1);
        return 1;
    }
}

