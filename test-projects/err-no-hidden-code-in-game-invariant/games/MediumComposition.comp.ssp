composition MediumComposition {
    const n: Integer;
    const f: fn Integer -> Integer;

    invariant: [
      ./games/MediumComposition.smt2
    ]

    instance rand = Rand {
        params {
            n:   n,
            f:   f,
        }
    }

    instance fwd = Fwd {
        params {
            n:   n,
        }
    }

    compose {
        adversary: {
            UsefulOracle: fwd,
        },
        fwd: {
            UsefulOracle: rand,
        },
    }
}
