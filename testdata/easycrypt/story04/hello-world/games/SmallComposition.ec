(* games/SmallComposition.ec for theorem `Proof`, composition `SmallComposition` — generated by `domino easycrypt`. *)

require import AllCore Distr FMap Int IntDiv Types.
require Interfaces Rand.

clone Rand as Pkg_Rand.

module Game_SmallComposition : Interfaces.Iface_SmallComposition = {
  var abort_flag : bool

  proc init() : unit = {
    abort_flag <- false;
    Pkg_Rand.Rand.init();
  }

  proc d_UsefulOracle() : (int * bits_n) option = {
    var ec_result : (int * bits_n) option <- None<:(int * bits_n)>;
    if (!abort_flag) {
      ec_result <@ Pkg_Rand.Rand.d_UsefulOracle();
      if (ec_result = None<:(int * bits_n)>) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }
}.

module Exp_SmallComposition (A : Interfaces.Adv_SmallComposition) = {
  proc run() : bool = {
    var b' : bool;
    Game_SmallComposition.init();
    b' <@ A(Game_SmallComposition).run();
    return b';
  }
}.
