composition HybridReal {
    /*
     * h-th hybrid, real side: gate layers 1..(h - 1) are simulated, gate layer h is
     * the real side of the Layer assumption, gate layers (h + 1)..d are real.
     *
     * All simulated and all real layers share one LayeredKeys instance; KeysFilter
     * carves wire layer h out to KeysTop and wire layer (h + 1) out to KeysBot.
     * For h = 0 this is CoreReal with the assumption packages left dangling.
     */

    const h: Integer; /* hybrid parameter */
    const n: Integer;
    const p: Integer;
    const m: Integer;
    const d: Integer;
    const enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance LayeredKeys = LayeredKeys {
        params {
            n: n,
        }
    }

    instance KeysFilter = KeysFilter {
        params {
            n: n,
            h: h,
            d: d,
        }
    }

    instance KeysTop = Keys {
        params {
            n: n,
        }
    }

    instance KeysBot = Keys {
        params {
            n: n,
        }
    }

    instance Enc = Enc0 {
        params {
            n: n,
            m: m,
            p: p,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    instance Gate = Gate {
        params {
            p: p,
            n: n,
            m: m,
        }
    }

    instance LayeredEval = LayeredEval {
        params {
            n: n,
        }
    }

    instance LayeredEnc0 = LayeredEnc0 {
        params {
            p: p,
            n: n,
            m: m,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    instance LayeredSim = LayeredSim {
        params {
            n: n,
            m: m,
            p: p,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    instance LayeredGate = LayeredGate {
        params {
            p: p,
            n: n,
            m: m,
        }
    }

    instance LayerMap = HybridLayerMap {
        params {
            n: n,
            d: d,
            h: h,
            p: p
        }
    }

    compose {
        adversary: {
            GenerateInputWireKeys: LayerMap,
            GetInputWireKey: LayerMap,
            SetInputBit: LayerMap,
            GarbleGate: LayerMap,
            GetOutputWireKeys: LayerMap,
        }
        LayerMap: {
            SetActiveBit: KeysFilter,
            GenerateWireKeys: KeysFilter,
            GetActiveWireKey: KeysFilter,
            GetWireKeys: KeysFilter,
            Assumption: GarbleGate of Gate,
            SimulateGarbledGate: LayeredSim,
            GarbleGate: LayeredGate,
        }
        KeysFilter: {
            TopSetActiveBit: SetActiveBit of KeysTop,
            TopGenerateWireKeys: GenerateWireKeys of KeysTop,
            TopGetActiveWireKey: GetActiveWireKey of KeysTop,
            BotGetWireKeys: GetWireKeys of KeysBot,
            SetActiveBit: LayeredKeys,
            GetActiveBit: LayeredKeys,
            GenerateWireKeys: LayeredKeys,
            GetWireKeys: LayeredKeys,
            GetActiveWireKey: LayeredKeys,
            GetInactiveWireKey: LayeredKeys,
        }
        Gate: {
            SetInputBit: SetActiveBit of KeysBot,
            GenerateWireKeys: KeysBot,
            GetWireKeys: KeysBot,
            EncInner: Enc,
            EncOuter: Enc,
        }
        Enc: {
            GetWireKeys: KeysTop,
        }
        LayeredGate: {
            SetInputBit: SetActiveBit of KeysFilter,
            GenerateWireKeys: KeysFilter,
            GetWireKeys: KeysFilter,
            EncInner: LayeredEnc0,
            EncOuter: LayeredEnc0,
        }
        LayeredEnc0: {
            GetWireKeys: KeysFilter,
        }
        LayeredSim: {
            Eval: LayeredEval,
            GetActiveWireKey: KeysFilter,
            GetInactiveWireKey: KeysFilter,
            GenerateWireKeys: KeysFilter,
        }
        LayeredEval: {
            GetActiveBit: KeysFilter,
            SetActiveBit: KeysFilter,
        }
    }
}
