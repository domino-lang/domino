    instance H6_1_0 = H6 {
        params {
            btest   : false ,
            bleast  : b ,
            bprf    : true,
            n       : n    ,
            prf     : prf  ,
            mac     : mac  ,
        }
    }

    instance H6_1_1 = H6 {
        params {
            btest   : true ,
            bleast  : b ,
            bprf    : true,
            n       : n    ,
            prf     : prf  ,
            mac     : mac  ,
