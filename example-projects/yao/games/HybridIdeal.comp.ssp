composition HybridIdeal {
    /*
     * h-th hybrid, ideal side: gate layers 1..(h - 1) are simulated, gate layer h is
     * the ideal side of the Layer assumption, gate layers (h + 1)..d are real.
     *
     * Identical to HybridReal except for the assumption layer itself (Eval / Simgate
     * instead of Enc0 / Gate). For h = d + 1 this is CoreIdeal with the assumption
     * packages left dangling.
     */

    const h: Integer; /* hybrid parameter */
    const n: Integer;
    const p: Integer;
    const m: Integer;
    const d: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance LayeredKeys = LayeredKeys {
        params {
            n: n,
        }
    }

    instance KeysFilter = KeysFilter {
        params {
            n: n,
            h: h,
            d: d,
        }
    }

    instance KeysTop = Keys {
        params {
            n: n,
        }
    }

    instance KeysBot = Keys {
        params {
            n: n,
        }
    }

    instance Ev = Eval {
        params {
            n: n
        }
    }

    instance Sim = Simgate {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance LayeredEval = LayeredEval {
        params {
            n: n,
        }
    }

    instance LayeredEnc0 = LayeredEnc0 {
        params {
            p: p,
            n: n,
            m: m,
            encn: encn,
            encm: encm,
        }
    }

    instance LayeredSim = LayeredSim {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance LayeredGate = LayeredGate {
        params {
            p: p,
            n: n,
            m: m,
        }
    }

    instance LayerMap = HybridLayerMap {
        params {
            n: n,
            d: d,
            h: h,
            p: p
        }
    }

    compose {
        adversary: {
            GenerateInputWireKeys: LayerMap,
            GetInputWireKey: LayerMap,
            SetInputBit: LayerMap,
            GarbleGate: LayerMap,
            GetWireKeys: LayerMap,
        }
        LayerMap: {
            SetActiveBit: KeysFilter,
            GenerateWireKeys: KeysFilter,
            GetActiveWireKey: KeysFilter,
            GetWireKeys: KeysFilter,
            Assumption: SimulateGarbledGate of Sim,
            SimulateGarbledGate: LayeredSim,
            GarbleGate: LayeredGate,
        }
        KeysFilter: {
            TopSetActiveBit: SetActiveBit of KeysTop,
            TopGenerateWireKeys: GenerateWireKeys of KeysTop,
            TopGetActiveWireKey: GetActiveWireKey of KeysTop,
            BotGetWireKeys: GetWireKeys of KeysBot,
            SetActiveBit: LayeredKeys,
            GetActiveBit: LayeredKeys,
            GenerateWireKeys: LayeredKeys,
            GetWireKeys: LayeredKeys,
            GetActiveWireKey: LayeredKeys,
            GetInactiveWireKey: LayeredKeys,
        }
        Sim: {
            GetActiveWireKey: KeysTop,
            GetInactiveWireKey: KeysTop,
            Eval: Ev,
            GenerateWireKeys: KeysBot,
            GetActiveOutputWireKey: GetActiveWireKey of KeysBot,
        }
        Ev: {
            GetActiveBit: KeysTop,
            SetActiveBit: KeysBot,
        }
        LayeredGate: {
            SetInputBit: SetActiveBit of KeysFilter,
            GenerateWireKeys: KeysFilter,
            GetWireKeys: KeysFilter,
            EncInner: LayeredEnc0,
            EncOuter: LayeredEnc0,
        }
        LayeredEnc0: {
            GetWireKeys: KeysFilter,
        }
        LayeredSim: {
            Eval: LayeredEval,
            GetActiveWireKey: KeysFilter,
            GetInactiveWireKey: KeysFilter,
            GenerateWireKeys: KeysFilter,
        }
        LayeredEval: {
            GetActiveBit: KeysFilter,
            SetActiveBit: KeysFilter,
        }
    }
}
