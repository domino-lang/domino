package A {
    params {
        n: Integer,
    }

    state {
        ctr: Integer,
    }

    /* determined: the second condition is decided by the first assert */
    oracle Determined(x: Integer) -> Integer {
        assert (x >= 0);
        if (x < 0) {
            r <- 1;
        } else {
            r <- 2;
        }
        return r;
    }

    /* synchronized: the same condition on both sides */
    oracle Synced(b: Bool) -> Integer {
        if b {
            r <- 1;
        } else {
            r <- 2;
        }
        return r;
    }

    /* split: unrelated conditions */
    oracle Split(b: Bool, c: Bool) -> Integer {
        if b {
            r <- 1;
        } else {
            r <- 2;
        }
        return r;
    }

    /* split with two infeasible combinations: the conditions are opposite */
    oracle SplitPruned(b: Bool) -> Integer {
        if b {
            r <- 1;
        } else {
            r <- 2;
        }
        return r;
    }

    /* a branch on the left side only */
    oracle OneSided(b: Bool) -> Integer {
        if b {
            r <- 1;
        } else {
            r <- 1;
        }
        return r;
    }

    /* synchronized sampling */
    oracle SyncSample() -> Bits(n) {
        r <-$ Bits(n) sample-name s;
        return r;
    }

    /* a sampling the mapping relates to nothing */
    oracle IndepSample() -> Bits(n) {
        t <-$ Bits(n) sample-name extra;
        r <-$ Bits(n) sample-name s;
        return r;
    }

    /* a mapping that depends on the argument */
    oracle StuckArg(x: Integer) -> Bits(n) {
        r <-$ Bits(n) sample-name s;
        return r;
    }

    /* the two sides draw in opposite orders */
    oracle StuckOrder() -> (Bits(n), Bits(n)) {
        a <-$ Bits(n) sample-name s1;
        d <-$ Bits(n) sample-name s2;
        return (a, d);
    }

    /* different outputs */
    oracle BadOutput(x: Integer) -> Integer {
        return x;
    }

    /* a state relation that breaks */
    oracle BadState(x: Integer) -> Integer {
        ctr <- (ctr + 1);
        return 0;
    }

    /* one side aborts where the other does not */
    oracle AbortDiff(b: Bool) -> Integer {
        assert b;
        return 1;
    }

    /* both sides abort together */
    oracle AbortBoth(b: Bool) -> Integer {
        assert b;
        return 1;
    }

    /* both abort, but the left one changed its state first */
    oracle AbortState(b: Bool) -> Integer {
        ctr <- (ctr + 1);
        assert b;
        return 1;
    }
}
