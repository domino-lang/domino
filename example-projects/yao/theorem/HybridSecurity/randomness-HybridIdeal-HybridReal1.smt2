(define-randomness-mapping GETAOUT
    (left right consts)
    (or
        (and
            (= consts.h 1)
            (= left.id (sample-id "KeysTop" "GETAOUT" "r"))
            (= right.id (sample-id "SimulatedLayersKeys" "LGETAOUT" "r"))
            (= left.ctr 0)
            (= right.ctr 0)
        )
        (and
            (= consts.h 1)
            (= left.id (sample-id "KeysTop" "GETAOUT" "rr"))
            (= right.id (sample-id "SimulatedLayersKeys" "LGETAOUT" "rr"))
            (= left.ctr 0)
            (= right.ctr 0)
        )
        (and
            (> consts.h 1)
            (= left.id (sample-id "SimulatedLayersKeys" "LGETAOUT" "r"))
            (= right.id (sample-id "SimulatedLayersKeys" "LGETAOUT" "r"))
            (= left.ctr 0)
            (= right.ctr 0)
        )
        (and
            (> consts.h 1)
            (= left.id (sample-id "SimulatedLayersKeys" "LGETAOUT" "rr"))
            (= right.id (sample-id "SimulatedLayersKeys" "LGETAOUT" "rr"))
            (= left.ctr 0)
            (= right.ctr 0)
        )
    )
)

