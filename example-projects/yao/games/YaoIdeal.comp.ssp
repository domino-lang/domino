composition YaoIdeal {
    const n: Integer;
    const p: Integer;
    const m: Integer;
    const d: Integer;
    const w: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance Keys = LayeredKeys {
        params {
            n: n,
        }
    }

    instance Ev = LayeredEval {
        params {
            n: n,
        }
    }

    instance Sim = LayeredSim {
        params {
            p: p,
            n: n,
            m: m,
            encn: encn,
            encm: encm,
        }
    }

    instance LayerMap = LayerMap {
        params {
            n: n,
            d: d,
            p: p
        }
    }

    instance MODGB = LayeredMODGB {
        params {
            p: p,
            w: w,
        }
    }

    instance Mod = Mod {
        params {
            w: w,
            d: d,
            p: p,
            n: n,
        }
    }

    compose {
        adversary: {
            GARBLE: Mod,
        }
        Mod: {
            GenerateInputWireKeys: LayerMap,
            GetInputWireKey: LayerMap,
            SetInputBit: LayerMap,
            GBL: MODGB,
            GetWireKeys: LayerMap,
        }
        MODGB: {
            GarbleGate: LayerMap,
        }
        LayerMap: {
            SetActiveBit: Keys,
            GenerateWireKeys: Keys,
            GetActiveWireKey: Keys,
            GetWireKeys: Keys,
            GarbleGate: SimulateGarbledGate of Sim,
        }
        Sim: {
            GetActiveWireKey: Keys,
            GetInactiveWireKey: Keys,
            GenerateWireKeys: Keys,
            Eval: Ev,
        }
        Ev: {
            GetActiveBit: Keys,
            SetActiveBit: Keys,
        }
    }
}