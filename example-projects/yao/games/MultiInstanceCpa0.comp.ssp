composition MultiInstanceCpa0 {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance cpa = MultiInstanceCpa {
        params {
            b: false,
            n: n,
            m: m,
            p: p,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    compose {
        adversary: {
            SampleKey: cpa,
            EncInner: cpa,
            EncOuter: cpa,
        }
    }
}
