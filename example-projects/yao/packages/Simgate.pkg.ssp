package Simgate {
    params {
        n: Integer,
        m: Integer,
        p: Integer,
        encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    import oracles {
        GETAIN(h: Integer) -> Bits(n),
        GETINAIN(h: Integer) -> Bits(n),
        EVAL(j: Integer, l: Integer, r: Integer, op: Table((Bool, Bool), Bool)),
        GETAOUT(h: Integer) -> Bits(n),
    }

    state {
        x: Integer
    }


    oracle GBLG(
        l: Integer,
        r: Integer,
        op: Table((Bool, Bool), Bool),
        j: Integer
    ) -> Table(Bits(p), Bool) {
        /*
        The simulated garbled gate consists of four rows.  Writing akl/ikl for the
        active/inactive key of the left input wire, akr/ikr for the ones of the
        right input wire and akj for the active key of the output wire:

            row A: encm(akr, encn(akl, akj))     the active row
            row F: encm(akr, encn(ikl, 0_n))     outer key active, inner key secret
            row Z: encm(ikr, 0_m)                outer key secret
            row Z: encm(ikr, 0_m)                outer key secret

        Whenever the *outer* key is the secret one, the real game (with ideal
        encryption) produces an encryption of zeros regardless of what the inner
        ciphertext was, so the simulator does not compute an inner ciphertext for
        those two rows at all.  This is why only six encryptions -- and hence six
        random coins -- need to be mapped.  The last two rows are encryptions of
        the same plaintext under the same key but with independent randomness,
        so they are distinct with high probability.

        The garbled gate is a *set* of four ciphertexts (a table mapping the
        elements to true), so the order of the rows is irrelevant.
        */
        C <- new Table(Bits(p), Bool);
        invoke EVAL(j, l, r, op);
        akl <- invoke GETAIN(l);
        ikl <- invoke GETINAIN(l);
        akr <- invoke GETAIN(r);
        ikr <- invoke GETINAIN(r);
        akj <- invoke GETAOUT(j);

        /* the active row */
        rin <-$ Bits(n) sample-name rin_active;
        rout <-$ Bits(n) sample-name rout_active;
        cin <- encn(akl, akj, rin);
        cout <- encm(akr, cin, rout);
        C[cout] <- Some(true);

        /* active outer key, inactive inner key */
        rin <-$ Bits(n) sample-name rin_inactive;
        rout <-$ Bits(n) sample-name rout_inactive;
        cin <- encn(ikl, 0_n, rin);
        cout <- encm(akr, cin, rout);
        C[cout] <- Some(true);

        /* inactive outer key: two independent encryptions of zeros */
        rout <-$ Bits(n) sample-name rout_zero_0;
        cout <- encm(ikr, 0_m, rout);
        C[cout] <- Some(true);

        rout <-$ Bits(n) sample-name rout_zero_1;
        cout <- encm(ikr, 0_m, rout);
        C[cout] <- Some(true);

        return C;
    }
}
