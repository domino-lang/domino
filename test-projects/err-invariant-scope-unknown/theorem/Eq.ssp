theorem Eq {
    instance A = A {}
    instance B = B {}

    gamehops {
        equivalence A B {
            Test: {
                randomness: simple
                invariant: [
                    theorem/invariant.smt2
                ]
                lemmas {
                    same-output: with invariants [nonexistent-fragment] [no-abort]
                }
            }
        }
    }
}
