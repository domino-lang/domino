theorem LayerSecurity {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance Twocpa0 = Twocpa0 {
        params {
            n: n,
            m: m,
            p: p,
            encm: encm,
            encn: encn,
        }
    }

    instance Twocpa1 = Twocpa1 {
        params {
            n: n,
            m: m,
            p: p,
            encm: encm,
            encn: encn,
        }
    }

    instance LayerReal = LayerReal {
        params {
            n: n,
            m: m,
            p: p,
            encm: encm,
            encn: encn,
        }
    }

    instance LayerHybrid = LayerHybrid {
        params {
            n: n,
            m: m,
            p: p,
            encm: encm,
            encn: encn,
        }
    }

    instance LayerIdeal = LayerIdeal {
        params {
            n: n,
            m: m,
            p: p,
            encm: encm,
            encn: encn,
        }
    }

    assumptions {
        Indcpa: Twocpa0 ~ Twocpa1
    }

    gamehops {
        reduction LayerReal LayerHybrid {
            assumption Indcpa

            map Twocpa0 LayerReal {
                keys_top: keys_top
                enc: enc
            }

            map Twocpa1 LayerHybrid {
                keys_top: keys_top
                enc: enc
            }
        }

        equivalence LayerHybrid LayerIdeal {
            invariant: [
                    ./theorem/LayerSecurity/invariant-Layer.smt2
                    ./theorem/LayerSecurity/randomness-Layer.smt2
                ]
            GETAOUT: {
                randomness: simple
                lemmas {
                    equal-aborts: []
                    invariant:    [no-abort]
                    same-output:  [no-abort]
                }
            }
            SETBIT: {
                randomness: none
                lemmas {
                    equal-aborts: []
                    invariant:    [no-abort]
                    same-output:  [no-abort]
                }
            }
            GETKEYSIN: {
                randomness: none
                lemmas {
                    equal-aborts: []
                    invariant:    [no-abort]
                    same-output:  [no-abort]
                }
            }
            GBLG: {
               lemmas {
                    same-output: [no-abort]
                    equal-aborts: []
                    invariant: [no-abort]
                    
                }
            }
        }
    }
    propositions {
        Layer: LayerReal ~ LayerIdeal
    }
}
