package Enc1 {
    /*
     * Ideal (real-or-zeros) encryption of the 2CPA game.
     *
     * Every wire h carries two keys: the *active* one K[z], which the adversary
     * learns, and the *inactive* one K[not z], which stays secret.  Encryptions
     * under the active key are real; encryptions under the inactive key are
     * replaced by encryptions of the all-zero string of the appropriate length.
     */
    params {
        n: Integer,
        m: Integer,
        p: Integer,
        encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    import oracles {
        GETKEYSIN(h: Integer) -> Table(Bool, Bits(n)),
        GETBIT(h: Integer) -> Bool,
    }


    oracle ENCN(j: Integer, d: Bool, msg: Bits(n)) -> Bits(m) {
        K <- invoke GETKEYSIN(j);
        z <- invoke GETBIT(j);
        r <-$ Bits(n) sample-name r;
        if (d == z) {
            c <- encn(Unwrap(K[d]), msg, r);
        } else {
            c <- encn(Unwrap(K[d]), 0_n, r);
        }
        return c;
    }

    oracle ENCM(j: Integer, d: Bool, msg: Bits(m)) -> Bits(p) {
        K <- invoke GETKEYSIN(j);
        z <- invoke GETBIT(j);
        r <-$ Bits(n) sample-name r;
        if (d == z) {
            c <- encm(Unwrap(K[d]), msg, r);
        } else {
            c <- encm(Unwrap(K[d]), 0_m, r);
        }
        return c;
    }
}
