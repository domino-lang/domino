composition LayerIdeal {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance keys_top = Keys {
        params {
            n: n,
        }
    }

    instance keys_bottom = Keys {
        params {
            n: n,
        }
    }

    instance ev = Eval {
        params {
            n: n,
        }
    }

    instance simgate = Simgate {
        params {
            n: n,
            m: m,
            p: p,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    compose {
        adversary: {
            GenerateInputWireKeys: GenerateWireKeys of keys_top,
            GetInputWireKey: GetActiveWireKey of keys_top,
            SetInputBit: SetActiveBit of keys_top,
            GarbleGate: SimulateGarbledGate of simgate,
            GetOutputWireKeys: GetWireKeys of keys_bottom,
        }
        simgate: {
            GetActiveWireKey: keys_top,
            GetInactiveWireKey: keys_top,
            Eval: ev,
            GenerateWireKeys: keys_bottom,
            GetActiveOutputWireKey: GetActiveWireKey of keys_bottom,
        }
        ev: {
            GetActiveBit: keys_top,
            SetActiveBit: keys_bottom,
        }
    }
}
