package LayeredGate {
    /* layered mirror of Gate */
    params {
        n: Integer,
        m: Integer,
        p: Integer,
    }

    import oracles {
        LSETBIT(i: Integer, j: Integer, b: Bool),
        LGETKEYSOUT(i: Integer, j: Integer) -> Table(Bool, Bits(n)),
        LENCN(i: Integer, j: Integer, b: Bool, msg: Bits(n)) -> Bits(m),
        LENCM(i: Integer, j: Integer, b: Bool, msg: Bits(m)) -> Bits(p),
    }

    oracle LGATEGBLG(
        i: Integer,
        l: Integer,
        r: Integer,
        op: Table((Bool, Bool), Bool),
        j: Integer
    ) -> Table(Bits(p), Bool) {
        invoke LSETBIT((i + 1), j, false);
        C <- new Table(Bits(p), Bool);
        Z <- invoke LGETKEYSOUT((i + 1), j);
        bl <- false;
        br <- false;
        bj <- Unwrap(op[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke LENCN(i, l, bl, kj);
        cout <- invoke LENCM(i, r, br, cin);
        C[cout] <- Some(true);
        bl <- true;
        br <- false;
        bj <- Unwrap(op[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke LENCN(i, l, bl, kj);
        cout <- invoke LENCM(i, r, br, cin);
        C[cout] <- Some(true);
        bl <- false;
        br <- true;
        bj <- Unwrap(op[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke LENCN(i, l, bl, kj);
        cout <- invoke LENCM(i, r, br, cin);
        C[cout] <- Some(true);
        bl <- true;
        br <- true;
        bj <- Unwrap(op[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke LENCN(i, l, bl, kj);
        cout <- invoke LENCM(i, r, br, cin);
        C[cout] <- Some(true);
        return C;
    }
}
