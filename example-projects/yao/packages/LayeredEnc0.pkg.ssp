package LayeredEnc0 {
    /* layered mirror of Enc0 (real encryption, real-or-zeros 2CPA flavour) */
    params {
        n: Integer,
        m: Integer,
        p: Integer,
        encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    import oracles {
        LGETKEYSIN(i: Integer, j: Integer) -> Table(Bool, Bits(n)),
    }

    oracle LENCN(
        i: Integer, 
        j: Integer, 
        b: Bool, 
        msg: Bits(n)) -> Bits(m) 
    {
        K <- invoke LGETKEYSIN(i, j);
        r <-$ Bits(n) sample-name r;
        c <- encn(Unwrap(K[b]), msg, r);
        return c;
    }

    oracle LENCM(
        i: Integer, 
        j: Integer, 
        b: Bool, 
        msg: Bits(m)) -> Bits(p) 
    {
        K <- invoke LGETKEYSIN(i, j);
        r <-$ Bits(n) sample-name r;
        c <- encm(Unwrap(K[b]), msg, r);
        return c;
    }
}
