(define-randomness-mapping GETAOUT
    (left right consts)
    (or 
        (and
            (> consts.d 1)
            (= left.id (sample-id "Keys" "LGETAOUT" "r"))
            (= right.id (sample-id "SimulatedLayersKeys" "LGETAOUT" "r"))
            (= left.ctr 0)
            (= right.ctr 0)
        )
        (and
            (> consts.d 1)
            (= left.id (sample-id "Keys" "LGETAOUT" "rr"))
            (= right.id (sample-id "SimulatedLayersKeys" "LGETAOUT" "rr"))
            (= left.ctr 0)
            (= right.ctr 0)
        )
        (and
            (= consts.d 1)
            (= left.id (sample-id "Keys" "LGETAOUT" "r"))
            (= right.id (sample-id "KeysTop" "GETAOUT" "r"))
            (= left.ctr 0)
            (= right.ctr 0)
        )
        (and
            (= consts.d 1)
            (= left.id (sample-id "Keys" "LGETAOUT" "rr"))
            (= right.id (sample-id "KeysTop" "GETAOUT" "rr"))
            (= left.ctr 0)
            (= right.ctr 0)
        )
    )
)

