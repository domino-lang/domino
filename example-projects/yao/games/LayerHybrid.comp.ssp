composition LayerHybrid {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance keys_top = Keys {
        params {
            n: n,
        }
    }

    instance keys_bottom = Keys {
        params {
            n: n,
        }
    }

    instance enc = Enc1 {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance gate = Gate {
        params {
            n: n,
            m: m,
            p: p,
        }
    }

    compose {
        adversary: {
            GenerateInputWireKeys: GenerateWireKeys of keys_top,
            GetInputWireKey: GetActiveWireKey of keys_top,
            SetInputBit: SetActiveBit of keys_top,
            GetOutputWireKeys: GetWireKeys of keys_bottom,
            GarbleGate: gate,
        }
        gate: {
            SetInputBit: SetActiveBit of keys_bottom,
            GenerateWireKeys: keys_bottom,
            GetWireKeys: keys_bottom,
            EncInner: enc,
            EncOuter: enc,
        }
        enc: {
            GetWireKeys: keys_top,
            GetActiveBit: keys_top,
        }
    }
}
