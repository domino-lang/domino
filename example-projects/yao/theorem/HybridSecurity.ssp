theorem HybridSecurity {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const d: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance LayerReal = LayerReal {
        params {
            n: n,
            m: m,
            p: p,
            encm: encm,
            encn: encn,
        }
    }

    instance LayerIdeal = LayerIdeal {
        params {
            n: n,
            m: m,
            p: p,
            encm: encm,
            encn: encn,
        }
    }

    instance CoreReal = CoreReal {
        params {
            n: n,
            m: m,
            p: p,
            d: d,
            encm: encm,
            encn: encn,
        }
    }

    instance CoreIdeal = CoreIdeal {
        params {
            n: n,
            m: m,
            p: p,
            d: d,
            encm: encm,
            encn: encn,
        }
    }

    instance FirstHybrid = HybridReal {
        params {
            n: n,
            m: m,
            p: p,
            d: d,
            h: 1,
            encm: encm,
            encn: encn,
        }
    }

    instance LastHybrid = HybridIdeal {
        params {
            n: n,
            m: m,
            p: p,
            d: d,
            h: d,
            encm: encm,
            encn: encn,
        }
    }

    hybrid instance Hybrid hy = {
        HybridReal {
            params{
                n: n,
                m: m,
                p: p,
                d: d,
                h: hy,
                encm: encm,
                encn: encn,
            }
        }
        HybridIdeal {
            params{
                n: n,
                m: m,
                p: p,
                d: d,
                h: hy,
                encm: encm,
                encn: encn,
            }
        }
    }


    assumptions {
        Layer: LayerReal ~ LayerIdeal
    }

    gamehops {
        equivalence CoreReal FirstHybrid {
            invariant: [
                    ./theorem/HybridSecurity/invariant-CoreReal-FirstHybrid.smt2
                    ./theorem/HybridSecurity/randomness-CoreReal-FirstHybrid.smt2
            ]
            SetInputBit: {
                randomness: none
            }
            GetInputWireKey: {
                randomness: none
            }
            GenerateInputWireKeys: {
            }
            GarbleGate: {
            }
            GetOutputWireKeys: {
                randomness: none
            }
        }
        equivalence CoreIdeal LastHybrid {
            invariant: [
                ./theorem/HybridSecurity/invariant-CoreIdeal-LastHybrid.smt2
                ./theorem/HybridSecurity/randomness-CoreIdeal-LastHybrid.smt2
                ./theorem/HybridSecurity/lemma-CoreIdeal-LastHybrid.smt2
            ]
            SetInputBit: {
                randomness: none
            }
            GetInputWireKey: {
                randomness: none
            }
            GenerateInputWireKeys: {
            }

            GarbleGate: {
                lemmas {
                    case-i-lt-dminusone: []
                    case-i-is-dminusone: []
                    case-i-is-d: []
                    same-output: [
                        no-abort,
                        case-i-lt-dminusone,
                        case-i-is-dminusone,
                        case-i-is-d
                    ]
                }
            }

            GetOutputWireKeys: {
                randomness: none
            }
        }
        hybrid Hybrid {
            reduction {
                assumption Layer
          
                map LayerReal Hybrid[false] {
                    keys_top: KeysTop
                    keys_bottom: KeysBot
                    enc: Enc
                    gate: Gate
                }
          
                map LayerIdeal Hybrid[true] {
                    keys_top: KeysTop
                    keys_bottom: KeysBot
                    ev: Ev
                    simgate: Sim
                }
            }
            equivalence {
                invariant: [
                    ./theorem/HybridSecurity/randomness-HybridIdeal-HybridReal1.smt2
                    ./theorem/HybridSecurity/invariant-HybridIdeal-HybridReal1.smt2
                    ./theorem/HybridSecurity/lemma-HybridIdeal-HybridReal1.smt2 /* depends on the invariant */
                ]
                SetInputBit: {
                    randomness: none
                    lemmas {
                        same-output:  [no-abort]
                        equal-aborts: []
                        invariant:    [no-abort]
                    }
                }
                GetInputWireKey: {
                    randomness: none
                    lemmas {
                        same-output:  [no-abort]
                        equal-aborts: []
                        invariant:    [no-abort]
                    }
                }
                GenerateInputWireKeys: {
                    lemmas {
                        same-output:  [no-abort]
                        equal-aborts: []
                        invariant:    [no-abort]
                    }
                }
          
                GarbleGate: {
                    lemmas {
                        inv-case-i-gt-hplustwo: [no-abort, inv-case-i-gt-hplustwo-assumptions]
                        inv-case-i-gt-hplustwo-assumptions: [no-abort]
                        invariant: [no-abort, 
                            inv-case-i-lt-hminusone, 
                            inv-case-i-is-hminusone, 
                            inv-case-i-is-h, 
                            inv-case-i-is-hplusone, 
                            inv-case-i-is-hplustwo, 
                            inv-case-i-gt-hplustwo]
                        inv-case-i-lt-hminusone-assumptions: [no-abort]
                        inv-case-i-lt-hminusone: [no-abort, inv-case-i-lt-hminusone-assumptions]
                        inv-case-i-is-hminusone: [no-abort]
                        inv-case-i-is-h: [no-abort]
                        inv-case-i-is-hplusone: [no-abort]
                        inv-case-i-is-hplustwo: [no-abort]
                        case-i-is-hminusone-assumptions: []
                        case-i-lt-hminusone-assumptions: []
                        case-i-is-h-assumptions: []
                        case-i-is-hplusone-assumptions: []
                        case-i-is-hplustwo-assumptions: []
                        case-i-gt-hplustwo-assumptions: []
                        same-output:  [no-abort, 
                            case-i-is-h, 
                            case-i-is-hplusone, 
                            case-i-is-hplustwo, 
                            case-i-gt-hplustwo, 
                            case-i-lt-hminusone, 
                            case-i-is-hminusone]
                        equal-aborts: [
                            case-i-is-h, 
                            case-i-is-hplusone, 
                            case-i-is-hplustwo, 
                            case-i-gt-hplustwo, 
                            case-i-lt-hminusone, 
                            case-i-is-hminusone]
                        case-i-gt-hplustwo: [case-i-gt-hplustwo-assumptions]
                        case-i-is-hplustwo: [case-i-is-hplustwo-assumptions]
                        case-i-is-h: [case-i-is-h-assumptions]
                        case-i-is-hplusone: [case-i-is-hplusone-assumptions]
                        case-i-is-hminusone: [case-i-is-hminusone-assumptions]
                        case-i-lt-hminusone: [case-i-lt-hminusone-assumptions]
                    }
                }
          
                GetOutputWireKeys: {
                    randomness: none
                    lemmas {
                        same-output:  [no-abort]
                        equal-aborts: []
                        invariant:    [no-abort]
                    }
                }
            }
        }
    }
    propositions {
      main: CoreReal ~ CoreIdeal
    }
}
