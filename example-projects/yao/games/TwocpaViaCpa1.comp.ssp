composition TwocpaViaCpa1 {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance cpa = MultiInstanceCpa {
        params {
            b: true,
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance reduction = TwocpaReduction {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    compose {
        reduction: {
            SAMPLEKEY: cpa,
            LR_ENCN: ENCN of cpa,
            LR_ENCM: ENCM of cpa,
        }
        adversary: {
            GETAOUT: reduction,
            SETBIT: reduction,
            ENCN: reduction,
            ENCM: reduction,
        }
    }
}
