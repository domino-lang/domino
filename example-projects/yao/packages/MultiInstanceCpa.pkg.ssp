package MultiInstanceCpa {
    /*
     * Multi-instance left-or-right CPA game for the two ciphertext lengths used
     * by the garbler: EncInner encrypts a wire key, EncOuter an inner ciphertext.
     */
    params {
        b: Bool,
        n: Integer,
        m: Integer,
        p: Integer,
        enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    state {
        Key: Table(Integer, Bits(n)),
    }

    oracle SampleKey(h: Integer) {
        assert (Key[h] == None as Bits(n));
        key <-$ Bits(n) sample-name key;
        Key[h] <- Some(key);
        return;
    }

    oracle EncInner(h: Integer, left: Bits(n), right: Bits(n)) -> Bits(m) {
        assert (Key[h] != None as Bits(n));
        key <- Unwrap(Key[h]);
        r <-$ Bits(n) sample-name r;
        if b {
            c <- enc_inner(key, right, r);
        } else {
            c <- enc_inner(key, left, r);
        }
        return c;
    }

    oracle EncOuter(h: Integer, left: Bits(m), right: Bits(m)) -> Bits(p) {
        assert (Key[h] != None as Bits(n));
        key <- Unwrap(Key[h]);
        r <-$ Bits(n) sample-name r;
        if b {
            c <- enc_outer(key, right, r);
        } else {
            c <- enc_outer(key, left, r);
        }
        return c;
    }
}
