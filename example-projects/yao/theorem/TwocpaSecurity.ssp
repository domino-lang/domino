theorem TwocpaSecurity {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance Twocpa0 = Twocpa0 {
        params {
            n: n,
            m: m,
            p: p,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    instance TwocpaReduction0 = TwocpaReduction {
        params {
            n: n,
            m: m,
            p: p,
            b: false,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    instance TwocpaReduction1 = TwocpaReduction {
        params {
            n: n,
            m: m,
            p: p,
            b: true,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    instance Twocpa1 = Twocpa1 {
        params {
            n: n,
            m: m,
            p: p,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    instance MultiInstanceCpa0 = MultiInstanceCpa {
        params {
            n: n,
            m: m,
            p: p,
            b: false,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    instance MultiInstanceCpa1 = MultiInstanceCpa {
        params {
            n: n,
            m: m,
            p: p,
            b: true,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    assumptions {
        MultiInstanceCpa: MultiInstanceCpa0 ~ MultiInstanceCpa1
    }

    gamehops {
        equivalence Twocpa0 TwocpaReduction0 {
            invariant: [
                ./theorem/TwocpaSecurity/invariant-left.smt2,
                ./theorem/TwocpaSecurity/randomness-left.smt2
            ]
            GenerateInputWireKeys: {
                randomness: custom
            }
            GetInputWireKey: {
                randomness: none
            }
            SetInputBit: {
                randomness: none
            }
            EncInner: {
                randomness: custom
            }
            EncOuter: {
                randomness: custom
            }
        }

        reduction TwocpaReduction0 TwocpaReduction1 {
            assumption MultiInstanceCpa

            map MultiInstanceCpa0 TwocpaReduction0 {
                cpa: cpa
            }

            map MultiInstanceCpa1 TwocpaReduction1 {
                cpa: cpa
            }
        }

        equivalence TwocpaReduction1 Twocpa1 {
            invariant: [
                ./theorem/TwocpaSecurity/invariant-right.smt2,
                ./theorem/TwocpaSecurity/randomness-right.smt2
            ]
            GenerateInputWireKeys: {
                randomness: custom
            }
            GetInputWireKey: {
                randomness: none
            }
            SetInputBit: {
                randomness: none
            }
            EncInner: {
                randomness: custom
            }
            EncOuter: {
                randomness: custom
            }
        }
    }

    propositions {
        Twocpa: Twocpa0 ~ Twocpa1
    }
}
