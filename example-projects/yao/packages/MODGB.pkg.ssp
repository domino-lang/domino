package MODGB {
    params {
        w: Integer,
        p: Integer,
    }

    import oracles {
       GarbleGate(
           left_input: Integer,
           right_input: Integer,
           gate: Table((Bool,Bool),Bool),
           output: Integer) -> Table(Bits(p),Bool),
    }

    oracle GBL(Ci: Table(Integer, (Integer, Integer, Table((Bool,Bool),Bool)))) 
             -> Table(Integer, Table(Bits(p), Bool)) {
        T   <- new Table(Integer, Table(Bits(p), Bool));
        tmp <- new Table(Bits(p),Bool);
        for wire: 1 <= wire <= w {
            (left_input, right_input, gate) <- parse Unwrap(Ci[wire]);
            assert not (gate[(true,  true)] == None);
            assert not (gate[(true, false)] == None);
            assert not (gate[(false, true)] == None);
            assert not (gate[(false,false)] == None);
            tmp <- invoke GarbleGate(left_input, right_input, gate, wire);
            T[wire] <- Some(tmp);
        }
        return T;
    }
}
