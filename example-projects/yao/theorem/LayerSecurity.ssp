theorem LayerSecurity {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance Twocpa0 = Twocpa0 {
        params {
            n: n,
            m: m,
            p: p,
            enc_outer: enc_outer,
            enc_inner: enc_inner,
        }
    }

    instance Twocpa1 = Twocpa1 {
        params {
            n: n,
            m: m,
            p: p,
            enc_outer: enc_outer,
            enc_inner: enc_inner,
        }
    }

    instance LayerReal = LayerReal {
        params {
            n: n,
            m: m,
            p: p,
            enc_outer: enc_outer,
            enc_inner: enc_inner,
        }
    }

    instance LayerHybrid = LayerHybrid {
        params {
            n: n,
            m: m,
            p: p,
            enc_outer: enc_outer,
            enc_inner: enc_inner,
        }
    }

    instance LayerIdeal = LayerIdeal {
        params {
            n: n,
            m: m,
            p: p,
            enc_outer: enc_outer,
            enc_inner: enc_inner,
        }
    }

    assumptions {
        Twocpa: Twocpa0 ~ Twocpa1
    }

    gamehops {
        reduction LayerReal LayerHybrid {
            assumption Twocpa

            map Twocpa0 LayerReal {
                keys_top: keys_top
                enc: enc
            }

            map Twocpa1 LayerHybrid {
                keys_top: keys_top
                enc: enc
            }
        }

        equivalence LayerHybrid LayerIdeal {
            invariant: [
                    ./theorem/LayerSecurity/invariant-Layer.smt2
                    ./theorem/LayerSecurity/randomness-Layer.smt2
                ]
            GenerateInputWireKeys: {
                randomness: simple
                lemmas {
                    equal-aborts: []
                    invariant:    [no-abort]
                    same-output:  [no-abort]
                }
            }
            GetInputWireKey: {
                randomness: none
                lemmas {
                    equal-aborts: []
                    invariant:    [no-abort]
                    same-output:  [no-abort]
                }
            }
            SetInputBit: {
                randomness: none
                lemmas {
                    equal-aborts: []
                    invariant:    [no-abort]
                    same-output:  [no-abort]
                }
            }
            GetOutputWireKeys: {
                randomness: none
                lemmas {
                    equal-aborts: []
                    invariant:    [no-abort]
                    same-output:  [no-abort]
                }
            }
            GarbleGate: {
               lemmas {
                    same-output: [no-abort]
                    equal-aborts: []
                    invariant: [no-abort]
                    
                }
            }
        }
    }
    propositions {
        Layer: LayerReal ~ LayerIdeal
    }
}
