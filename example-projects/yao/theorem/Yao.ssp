theorem Yao {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const d: Integer;
    const w: Integer;
    const enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance CoreReal = CoreReal {
        params {
            n: n,
            m: m,
            p: p,
            d: d,
            enc_outer: enc_outer,
            enc_inner: enc_inner,
        }
    }

    instance CoreIdeal = CoreIdeal {
        params {
            n: n,
            m: m,
            p: p,
            d: d,
            enc_outer: enc_outer,
            enc_inner: enc_inner,
        }
    }

    instance YaoReal = YaoReal {
        params {
            n: n,
            m: m,
            p: p,
            d: d,
            w: w,
            enc_outer: enc_outer,
            enc_inner: enc_inner
        }
    }

    instance YaoIdeal = YaoIdeal {
        params {
            n: n,
            m: m,
            p: p,
            d: d,
            w: w,
            enc_outer: enc_outer,
            enc_inner: enc_inner
        }
    }

    assumptions {
        HybridSecurity: CoreReal ~ CoreIdeal
    }

    gamehops {
        reduction YaoReal YaoIdeal {
            assumption HybridSecurity

            map CoreReal YaoReal {
                Keys: Keys
                Enc: Enc
                Gate: Gate
                LayerMap: LayerMap
            }

            map CoreIdeal YaoIdeal {
                Keys: Keys
                Ev: Ev
                Sim: Sim
                LayerMap: LayerMap
            }
        }
    }
    
    propositions {
        Yao: YaoReal ~ YaoIdeal
    }
}
