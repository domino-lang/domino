package Gate {
    params {
        n: Integer,
        m: Integer,
        p: Integer,
    }

    import oracles {
        SETBIT(h: Integer, a: Bool),
        GETKEYSOUT(h: Integer) -> Table(Bool, Bits(n)),
        ENCN(j: Integer, d: Bool, msg: Bits(n)) -> Bits(m),
        ENCM(j: Integer, d: Bool, msg: Bits(m)) -> Bits(p),
    }

    oracle GBLG(
        l: Integer,
        r: Integer,
        op: Table((Bool, Bool), Bool),
        j: Integer
    ) -> Table(Bits(p), Bool) {
        /*
        Set a dummy as the input bit of the next layer.
        This helps to drop the used-to "flag" in the Keys package which aimed
        to simulate input bits in lower layers (other than circuit input bits which 
        is set on both sides) and help proving equivalence of layer with 
        ideal encryption with a simulated layer because the simulated layer 
        sets the true input bit of the next.
        We garble a gate without looking into the inputs to the gate so we are not 
        allowed to compute the gate output here. This will also break the encryption 
        assumption.
        In the real game, the encryption oracle does not need 
        the input. However, the ideal encryption requires the input bit which 
        indicates the secret key. However, we only idealize a layer 
        when previous layers are already simulated (or is the circuit input)
        and hence are true input bits. 
        */
        /*
        Each of the four rows is the *real* nested encryption
            ENCM(r, br, ENCN(l, bl, Z[op(bl, br)]))
        of the output wire key belonging to the row.  Idealization happens
        entirely inside the encryption package (real-or-zeros 2CPA), so the
        garbler never needs a second "right" message.
        */
        invoke SETBIT(j, false);
        C <- new Table(Bits(p), Bool);
        Z <- invoke GETKEYSOUT(j);
        bl <- false;
        br <- false;
        bj <- Unwrap(op[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke ENCN(l, bl, kj);
        cout <- invoke ENCM(r, br, cin);
        C[cout] <- Some(true);
        bl <- true;
        br <- false;
        bj <- Unwrap(op[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke ENCN(l, bl, kj);
        cout <- invoke ENCM(r, br, cin);
        C[cout] <- Some(true);
        bl <- false;
        br <- true;
        bj <- Unwrap(op[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke ENCN(l, bl, kj);
        cout <- invoke ENCM(r, br, cin);
        C[cout] <- Some(true);
        bl <- true;
        br <- true;
        bj <- Unwrap(op[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke ENCN(l, bl, kj);
        cout <- invoke ENCM(r, br, cin);
        C[cout] <- Some(true);
        return C;
    }
}
