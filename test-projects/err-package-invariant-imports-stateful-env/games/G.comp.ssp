composition G {
    const n: Integer;

    instance ctr = Ctr {
        params {
            n: n,
        }
    }

    instance src = Src {
        params {
            n: n,
        }
    }

    compose {
        adversary: {
            Step: ctr,
            Peek: ctr,
        },
        ctr: {
            Get: src,
        },
    }
}
