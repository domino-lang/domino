composition Composition_Correct_KEM {
    const b: Bool;
    const pkeyl: Integer;
    const skeyl: Integer;
    const dkeyl: Integer;
    const kctl: Integer;
    const kgenr: Integer;
    const kencr: Integer;

    const kem_gen: fn Bits(*), Bits(kgenr) -> (Bits(*), Bits(pkeyl), Bits(skeyl));
    const kem_encaps: fn Bits(*), Bits(kencr), Bits(pkeyl) -> (Bits(*), Bits(dkeyl), Bits(kctl));
    const kem_decaps: fn Bits(*), Bits(skeyl), Bits(kctl) -> (Bits(*), Maybe(Bits(dkeyl)));
    const kem_interfere: fn Bits(*), Bits(*) -> (Bits(*), Bits(*));

    instance Scheme_KEM = Scheme_KEM {
        params {
            kem_gen: kem_gen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
            kem_interfere: kem_interfere,
            pkeyl: pkeyl,
            skeyl: skeyl,
            dkeyl: dkeyl,
            kctl: kctl,
            kgenr: kgenr,
            kencr: kencr,
        }
    }

    instance Correct_KEM = Correct_KEM {
        params {
            b: b,
            pkeyl: pkeyl,
            skeyl: skeyl,
            dkeyl: dkeyl,
            kctl: kctl,
        }
    }

    compose {
        Correct_KEM: {
            KEM_GEN: Scheme_KEM,
            KEM_ENCAPS: Scheme_KEM,
            KEM_DECAPS: Scheme_KEM,
            KEM_Interfere: Scheme_KEM,
        }
        adversary: {
            CORR_GEN: Correct_KEM,
            CORR_ENCAPS: Correct_KEM,
            CORR_DECAPS: Correct_KEM,
            CORR_Interfere: Correct_KEM,
        }
    }

}
