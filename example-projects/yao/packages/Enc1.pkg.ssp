package Enc1 {
    /*
     * Ideal (real-or-zeros) encryption of the 2CPA game.
     *
     * Every wire carries two keys: the *active* one K[active_bit], which the
     * adversary learns, and the *inactive* one K[not active_bit], which stays
     * secret.  Encryptions under the active key are real; encryptions under the
     * inactive key are replaced by encryptions of the all-zero string of the
     * appropriate length.
     */
    params {
        n: Integer,
        m: Integer,
        p: Integer,
        enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    import oracles {
        GetWireKeys(wire: Integer) -> Table(Bool, Bits(n)),
        GetActiveBit(wire: Integer) -> Bool,
    }


    oracle EncInner(wire: Integer, bit: Bool, msg: Bits(n)) -> Bits(m) {
        K <- invoke GetWireKeys(wire);
        active_bit <- invoke GetActiveBit(wire);
        r <-$ Bits(n) sample-name r;
        if (bit == active_bit) {
            c <- enc_inner(Unwrap(K[bit]), msg, r);
        } else {
            c <- enc_inner(Unwrap(K[bit]), 0_n, r);
        }
        return c;
    }

    oracle EncOuter(wire: Integer, bit: Bool, msg: Bits(m)) -> Bits(p) {
        K <- invoke GetWireKeys(wire);
        active_bit <- invoke GetActiveBit(wire);
        r <-$ Bits(n) sample-name r;
        if (bit == active_bit) {
            c <- enc_outer(Unwrap(K[bit]), msg, r);
        } else {
            c <- enc_outer(Unwrap(K[bit]), 0_m, r);
        }
        return c;
    }
}
