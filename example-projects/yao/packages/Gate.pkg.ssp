package Gate {
    params {
        n: Integer,
        m: Integer,
        p: Integer,
    }

    import oracles {
        /* on the wire layer below: the output wire of this gate */
        SetInputBit(wire: Integer, bit: Bool),
        GenerateWireKeys(wire: Integer),
        GetWireKeys(wire: Integer) -> Table(Bool, Bits(n)),

        /* on the wire layer above: the input wires of this gate */
        EncInner(wire: Integer, bit: Bool, msg: Bits(n)) -> Bits(m),
        EncOuter(wire: Integer, bit: Bool, msg: Bits(m)) -> Bits(p),
    }

    oracle GarbleGate(
        left_input: Integer,
        right_input: Integer,
        gate: Table((Bool, Bool), Bool),
        output: Integer
    ) -> Table(Bits(p), Bool) {
        /*
        Set a dummy as the input bit of the next layer.
        This helps to drop the used-to "flag" state of the Keys package which aimed
        to simulate input bits in lower layers (other than circuit input bits which 
        is set on both sides) and help proving equivalence of layer with 
        ideal encryption with a simulated layer because the simulated layer 
        sets the true input bit of the next.
        We garble a gate without looking into the inputs to the gate so we are not 
        allowed to compute the gate output here. This will also break the encryption 
        assumption.
        In the real game, the encryption oracle does not need 
        the input. However, the ideal encryption requires the input bit which 
        indicates the secret key. However, we only idealize a layer 
        when previous layers are already simulated (or is the circuit input)
        and hence are true input bits. 
        */
        invoke SetInputBit(output, false);
        C <- new Table(Bits(p), Bool);
        invoke GenerateWireKeys(output);
        Z <- invoke GetWireKeys(output);
        bl <- false;
        br <- false;
        bj <- Unwrap(gate[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke EncInner(left_input, bl, kj);
        cout <- invoke EncOuter(right_input, br, cin);
        C[cout] <- Some(true);
        bl <- true;
        br <- false;
        bj <- Unwrap(gate[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke EncInner(left_input, bl, kj);
        cout <- invoke EncOuter(right_input, br, cin);
        C[cout] <- Some(true);
        bl <- false;
        br <- true;
        bj <- Unwrap(gate[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke EncInner(left_input, bl, kj);
        cout <- invoke EncOuter(right_input, br, cin);
        C[cout] <- Some(true);
        bl <- true;
        br <- true;
        bj <- Unwrap(gate[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke EncInner(left_input, bl, kj);
        cout <- invoke EncOuter(right_input, br, cin);
        C[cout] <- Some(true);
        return C;
    }
}
