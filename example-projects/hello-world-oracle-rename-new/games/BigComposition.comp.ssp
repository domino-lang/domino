composition BigComposition {
    const n: Integer;

    instance rand = Rand {
        params {
            n:   n,
        }
    }

    instance fwd = Fwd {
        params {
            n:   n,
        }
    }

    instance fwd2 = Fwd {
        params {
            n:   n,
        }
    }

    compose {
        adversary: {
            UsefulOracle: fwd2,
            UselessOracle: fwd2,
            AnotherUsefulOracle: UsefulOracle of fwd,
        },
        fwd: {
            ChangeNameUsefulOracle: UsefulOracle of rand,
            AnotherUsefulOracle:    UsefulOracle of rand,
        },
        fwd2: {
            ChangeNameUsefulOracle: UsefulOracle of fwd,
            AnotherUsefulOracle:    UsefulOracle of fwd,
        },
    }
}
