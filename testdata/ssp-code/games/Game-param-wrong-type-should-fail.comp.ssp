composition ConstructionReal {
    const n: Integer;
    const m: Bits(n);
    const prf: fn Bits(n), Bits(n) -> Bits(n);
    const enc: fn Bits(n), Bits(n), Bits(n) -> Bits(m);
    
    instance Prf = PRF {
        params {
            n:   n,
            prf: prf,
        }
    }
    
    instance key = KeyReal {
        params {
            n: n,
        }
    }
    
    instance Enc = Enc {
        params {
            n:   n,
            m:   m,
            enc: enc,
        }
    }
    
    compose {
        adversary: {
            Eval: Prf,
            Enc:  Enc,
        },
        Prf: {
            Set: key,
        },
        Enc: {
            Get: key,
        }
    }
}
