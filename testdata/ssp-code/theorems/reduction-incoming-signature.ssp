theorem Diagnostic {
    instance a0 = AssumptionGame { params { width: 1 } }
    instance a1 = AssumptionGame { params { width: 1 } }
    instance c0 = ConstructionGame {}
    instance c1 = ConstructionGame {}
    assumptions { Basic: a0 ~ a1 }
    gamehops {
        reduction c0 c1 {
            assumption Basic
            map a0 c0 { leaf: leaf }
            map a1 c1 { leaf: leaf }
        }
    }
}
