package LayeredEnc0 {
    /* layered mirror of Enc0 */
    params {
        n: Integer,
        m: Integer,
        p: Integer,
        enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    import oracles {
        GetWireKeys(layer: Integer, wire: Integer) -> Table(Bool, Bits(n)),
    }

    oracle EncInner(
        layer: Integer,
        wire: Integer,
        bit: Bool,
        msg: Bits(n)) -> Bits(m)
    {
        K <- invoke GetWireKeys(layer, wire);
        r <-$ Bits(n) sample-name r;
        c <- enc_inner(Unwrap(K[bit]), msg, r);
        return c;
    }

    oracle EncOuter(
        layer: Integer,
        wire: Integer,
        bit: Bool,
        msg: Bits(m)) -> Bits(p)
    {
        K <- invoke GetWireKeys(layer, wire);
        r <-$ Bits(n) sample-name r;
        c <- enc_outer(Unwrap(K[bit]), msg, r);
        return c;
    }
}
