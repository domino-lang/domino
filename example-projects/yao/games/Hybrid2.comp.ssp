composition Hybrid2 {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const w: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance keys0 = Keys {
        params {
            n: n,
        }
    }

    instance keys1 = Keys {
        params {
            n: n,
        }
    }

    instance keys2 = Keys {
        params {
            n: n,
        }
    }

    instance keys3 = Keys {
        params {
            n: n,
        }
    }

    instance ev1 = Eval {
        params {
            n: n,
        }
    }

    instance simgate1 = Simgate {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance ev2 = Eval {
        params {
            n: n,
        }
    }

    instance simgate2 = Simgate {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance gate3 = Gate {
        params {
            n: n,
            m: m,
            p: p,
        }
    }

    instance enc3 = Enc0 {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance modgb1 = MODGB {
        params {
            p: p,
            w: w,
        }
    }

    instance modgb2 = MODGB {
        params {
            p: p,
            w: w,
        }
    }

    instance modgb3 = MODGB {
        params {
            p: p,
            w: w,
        }
    }
    
    instance Mod = Mod3Layer {
        params {
            w: w,
            p: p,
            n: n,
        }
    }

    compose {
        adversary: {
            GARBLE: Mod,
        }
        Mod: {
            GenerateInputWireKeys: GenerateWireKeys of keys0,
            GetInputWireKey: GetActiveWireKey of keys0,
            SetInputBit: SetActiveBit of keys0,
            GBL1: GBL of modgb1,
            GBL2: GBL of modgb2,
            GBL3: GBL of modgb3,
            GetWireKeys: keys3,
        }
        modgb1: {
            GarbleGate: SimulateGarbledGate of simgate1,
        }
        simgate1: {
            GetActiveWireKey: keys0,
            GetInactiveWireKey: keys0,
            Eval: ev1,
            GenerateWireKeys: keys1,
            GetActiveOutputWireKey: GetActiveWireKey of keys1,
        }
        ev1: {
            GetActiveBit: keys0,
            SetActiveBit: keys1,
        }        
        modgb2: {
            GarbleGate: SimulateGarbledGate of simgate2,
        }
        simgate2: {
            GetActiveWireKey: keys1,
            GetInactiveWireKey: keys1,
            Eval: ev2,
            GenerateWireKeys: keys2,
            GetActiveOutputWireKey: GetActiveWireKey of keys2,
        }
        ev2: {
            GetActiveBit: keys1,
            SetActiveBit: keys2,
        }        
        modgb3: {
            GarbleGate: gate3,
        }
        gate3: {
            SetInputBit: SetActiveBit of keys3,
            GenerateWireKeys: keys3,
            GetWireKeys: keys3,
            EncInner: enc3,
            EncOuter: enc3,
        }
        enc3: {
            GetWireKeys: keys2,
        }
    }
}
