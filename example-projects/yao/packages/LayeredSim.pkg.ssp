package LayeredSim {
    /* layered mirror of Simgate -- see Simgate.pkg.ssp for the row layout */
    params {
        n: Integer,
        m: Integer,
        p: Integer,
        encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    import oracles {
        LGETAIN(i: Integer, j: Integer) -> Bits(n),
        LGETINAIN(i: Integer, j: Integer) -> Bits(n),
        LEVAL(i: Integer, j: Integer, l: Integer, r: Integer, op: Table((Bool, Bool), Bool)),
        LGETAOUT(i: Integer, j: Integer) -> Bits(n),
    }

    oracle LSIMGBLG(
        i: Integer,
        l: Integer,
        r: Integer,
        op: Table((Bool, Bool), Bool),
        j: Integer
    ) -> Table(Bits(p), Bool) {
        C <- new Table(Bits(p), Bool);
        invoke LEVAL(i, j, l, r, op);
        akl <- invoke LGETAIN(i, l);
        ikl <- invoke LGETINAIN(i, l);
        akr <- invoke LGETAIN(i, r);
        ikr <- invoke LGETINAIN(i, r);
        akj <- invoke LGETAOUT((i + 1), j);

        /* the active row */
        rin <-$ Bits(n) sample-name rin_active;
        rout <-$ Bits(n) sample-name rout_active;
        cin <- encn(akl, akj, rin);
        cout <- encm(akr, cin, rout);
        C[cout] <- Some(true);

        /* active outer key, inactive inner key */
        rin <-$ Bits(n) sample-name rin_inactive;
        rout <-$ Bits(n) sample-name rout_inactive;
        cin <- encn(ikl, 0_n, rin);
        cout <- encm(akr, cin, rout);
        C[cout] <- Some(true);

        /* inactive outer key: two independent encryptions of zeros */
        rout <-$ Bits(n) sample-name rout_zero_0;
        cout <- encm(ikr, 0_m, rout);
        C[cout] <- Some(true);

        rout <-$ Bits(n) sample-name rout_zero_1;
        cout <- encm(ikr, 0_m, rout);
        C[cout] <- Some(true);

        return C;
    }
}
