theorem Proof {
    const n: Integer;
    const m: Integer;
    const z_n: Bits(n);
    const z_m: Bits(m);

    instance G_n = GA {
        params {
            x: n,
            z: z_n
        }
    }

    instance G_m = GB {
        params {
            x: m,
            z: z_m
        }
    }

    gamehops {
        equivalence G_n G_m {
            invariant: [
                ./theorem/inv.smt2
            ]
            Get: {
                randomness: none
                lemmas {
                    same-output: [no-abort]
                    equal-aborts: []
                    invariant: [no-abort]
                }
            }
        }
    }
}
