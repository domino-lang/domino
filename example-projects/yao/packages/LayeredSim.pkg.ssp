package LayeredSim {
    /* layered mirror of Simgate -- see Simgate.pkg.ssp for the row layout */
    params {
        n: Integer,
        m: Integer,
        p: Integer,
        enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    import oracles {
        GetActiveWireKey(layer: Integer, wire: Integer) -> Bits(n),
        GetInactiveWireKey(layer: Integer, wire: Integer) -> Bits(n),
        GenerateWireKeys(layer: Integer, wire: Integer),
        Eval(layer: Integer, output: Integer, left_input: Integer,
             right_input: Integer, gate: Table((Bool, Bool), Bool)),
    }

    oracle SimulateGarbledGate(
        layer: Integer,
        left_input: Integer,
        right_input: Integer,
        gate: Table((Bool, Bool), Bool),
        output: Integer
    ) -> Table(Bits(p), Bool) {
        C <- new Table(Bits(p), Bool);
        invoke Eval(layer, output, left_input, right_input, gate);
        akl <- invoke GetActiveWireKey(layer, left_input);
        ikl <- invoke GetInactiveWireKey(layer, left_input);
        akr <- invoke GetActiveWireKey(layer, right_input);
        ikr <- invoke GetInactiveWireKey(layer, right_input);
        invoke GenerateWireKeys((layer + 1), output);
        akj <- invoke GetActiveWireKey((layer + 1), output);

        /* the active row */
        rin <-$ Bits(n) sample-name rin_active;
        rout <-$ Bits(n) sample-name rout_active;
        cin <- enc_inner(akl, akj, rin);
        cout <- enc_outer(akr, cin, rout);
        C[cout] <- Some(true);

        /* active outer key, inactive inner key */
        rin <-$ Bits(n) sample-name rin_inactive;
        rout <-$ Bits(n) sample-name rout_inactive;
        cin <- enc_inner(ikl, 0_n, rin);
        cout <- enc_outer(akr, cin, rout);
        C[cout] <- Some(true);

        /* inactive outer key: two independent encryptions of zeros */
        rout <-$ Bits(n) sample-name rout_zero_0;
        cout <- enc_outer(ikr, 0_m, rout);
        C[cout] <- Some(true);

        rout <-$ Bits(n) sample-name rout_zero_1;
        cout <- enc_outer(ikr, 0_m, rout);
        C[cout] <- Some(true);

        return C;
    }
}
