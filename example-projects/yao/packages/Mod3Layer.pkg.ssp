package Mod3Layer {
    params {
        w: Integer,
        p: Integer,
        n: Integer,
    }

    import oracles {
        SetInputBit(wire: Integer, bit: Bool),
        GBL1(Ci: Table(Integer, (Integer, Integer, Table((Bool,Bool),Bool)))) 
             -> Table(Integer, Table(Bits(p), Bool)),
        GBL2(Ci: Table(Integer, (Integer, Integer, Table((Bool,Bool),Bool)))) 
             -> Table(Integer, Table(Bits(p), Bool)),
        GBL3(Ci: Table(Integer, (Integer, Integer, Table((Bool,Bool),Bool)))) 
             -> Table(Integer, Table(Bits(p), Bool)),
        GenerateInputWireKeys(wire: Integer),
        GetInputWireKey(wire: Integer) -> Bits(n),
        GetWireKeys(wire: Integer) -> Table(Bool, Bits(n)),
    }

    oracle GARBLE(
        C: Table(Integer,Table(Integer,(Integer,Integer,Table((Bool,Bool),Bool)))),
        x:Table(Integer,Bool)) 
        -> (Table(Integer,Table(Integer,Table(Bits(p), Bool))),
                        Table(Integer, Bits(n)),
                        Table(Integer,Table(Bool,Bits(n))))
    {
        xtilde <- new Table(Integer, Bits(n));
        for wire: 1 <= wire <= w {
            assert (x[wire] != None);
            z <- Unwrap(x[wire]);
            invoke SetInputBit(wire, z);
            invoke GenerateInputWireKeys(wire);
            k <- invoke GetInputWireKey(wire);
            xtilde[wire] <- Some(k);
        }
        Ctilde <- new Table(Integer,Table(Integer,Table(Bits(p), Bool)));
        assert (C[1] != None);
        Ci <- Unwrap(C[1]);
        gCi <- invoke GBL1(Ci);
        Ctilde[1] <- Some(gCi);
        assert (C[2] != None);
        Ci <- Unwrap(C[2]);
        gCi <- invoke GBL2(Ci);
        Ctilde[2] <- Some(gCi);
        assert (C[3] != None);
        Ci <- Unwrap(C[3]);
        gCi <- invoke GBL3(Ci);
        Ctilde[3] <- Some(gCi);
        dinf   <- new Table(Integer,Table(Bool,Bits(n)));
        for wire: 1 <= wire <= w {
            ktable <- invoke GetWireKeys(wire);
            dinf[wire] <- Some(ktable);
        }
        return (Ctilde,xtilde,dinf);
    }
}