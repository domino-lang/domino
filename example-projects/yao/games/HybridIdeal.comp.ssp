composition HybridIdeal {
    /*
     * h-th hybrid, ideal side: gate layers 1..(h - 1) are simulated, gate layer h is
     * the ideal side of the Layer assumption, gate layers (h + 1)..d are real.
     *
     * Identical to HybridReal except for the assumption layer itself (Lev / Simgate
     * instead of Enc0 / Gate). For h = d + 1 this is CoreIdeal with the assumption
     * packages left dangling.
     */

    const h: Integer; /* hybrid parameter */
    const n: Integer;
    const p: Integer;
    const m: Integer;
    const d: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance LayeredKeys = LayeredKeys {
        params {
            n: n,
        }
    }

    instance KeysFilter = KeysFilter {
        params {
            n: n,
            h: h,
            d: d,
        }
    }

    instance KeysTop = Keys {
        params {
            n: n,
        }
    }

    instance KeysBot = Keys {
        params {
            n: n,
        }
    }

    instance Lev = Lev {
        params {
            n: n
        }
    }

    instance Sim = Simgate {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance LayeredLev = LayeredLev {
        params {
            n: n,
        }
    }

    instance LayeredEnc0 = LayeredEnc0 {
        params {
            p: p,
            n: n,
            m: m,
            encn: encn,
            encm: encm,
        }
    }

    instance LayeredSim = LayeredSim {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance LayeredGate = LayeredGate {
        params {
            p: p,
            n: n,
            m: m,
        }
    }

    instance LayerMap = HybridLayerMap {
        params {
            n: n,
            d: d,
            h: h,
            p: p
        }
    }

    compose {
        adversary: {
            GETAOUT: LayerMap,
            SETBIT: LayerMap,
            GBLG: LayerMap,
            GETKEYSIN: LayerMap,
        }
        LayerMap: {
            LSETBIT: KeysFilter,
            LGETAOUT: KeysFilter,
            LGETKEYSIN: KeysFilter,
            GBLG: Sim,
            LSIMGBLG: LayeredSim,
            LGATEGBLG: LayeredGate,
        }
        KeysFilter: {
            SETBIT: KeysTop,
            GETAOUT: KeysTop,
            GETKEYSIN: KeysBot,
            LSETBIT: LayeredKeys,
            LGETAOUT: LayeredKeys,
            LGETKEYSIN: LayeredKeys,
            LGETAIN: LayeredKeys,
            LGETINAIN: LayeredKeys,
            LGETKEYSOUT: LayeredKeys,
            LGETBIT: LayeredKeys,
        }
        Sim: {
            GETAIN: KeysTop,
            GETINAIN: KeysTop,
            EVAL: Lev,
            GETAOUT: KeysBot,
        }
        Lev: {
            GETBIT: KeysTop,
            SETBIT: KeysBot,
        }
        LayeredGate: {
            LSETBIT: KeysFilter,
            LENCN: LayeredEnc0,
            LENCM: LayeredEnc0,
            LGETKEYSOUT: KeysFilter,
        }
        LayeredEnc0: {
            LGETKEYSIN: KeysFilter,
        }
        LayeredSim: {
            LEVAL: LayeredLev,
            LGETAIN: KeysFilter,
            LGETINAIN: KeysFilter,
            LGETAOUT: KeysFilter,
        }
        LayeredLev: {
            LGETBIT: KeysFilter,
            LSETBIT: KeysFilter,
        }
    }
}
