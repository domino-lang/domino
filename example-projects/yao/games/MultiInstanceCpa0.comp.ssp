composition MultiInstanceCpa0 {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance cpa = MultiInstanceCpa {
        params {
            b: false,
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    compose {
        adversary: {
            SampleKey: cpa,
            EncInner: cpa,
            EncOuter: cpa,
        }
    }
}
