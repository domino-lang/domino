composition HybridReal {
    /*
     * h-th hybrid, real side: gate layers 1..(h - 1) are simulated, gate layer h is
     * the real side of the Layer assumption, gate layers (h + 1)..d are real.
     *
     * All simulated and all real layers share one LayeredKeys instance; KeysFilter
     * carves wire layer h out to KeysTop and wire layer (h + 1) out to KeysBot.
     * For h = 0 this is CoreReal with the assumption packages left dangling.
     */

    const h: Integer; /* hybrid parameter */
    const n: Integer;
    const p: Integer;
    const m: Integer;
    const d: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance LayeredKeys = LayeredKeys {
        params {
            n: n,
        }
    }

    instance KeysFilter = KeysFilter {
        params {
            n: n,
            h: h,
            d: d,
        }
    }

    instance KeysTop = Keys {
        params {
            n: n,
        }
    }

    instance KeysBot = Keys {
        params {
            n: n,
        }
    }

    instance Enc = Enc0 {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance Gate = Gate {
        params {
            p: p,
            n: n,
            m: m,
        }
    }

    instance LayeredLev = LayeredLev {
        params {
            n: n,
        }
    }

    instance LayeredEnc0 = LayeredEnc0 {
        params {
            p: p,
            n: n,
            m: m,
            encn: encn,
            encm: encm,
        }
    }

    instance LayeredSim = LayeredSim {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance LayeredGate = LayeredGate {
        params {
            p: p,
            n: n,
            m: m,
        }
    }

    instance LayerMap = HybridLayerMap {
        params {
            n: n,
            d: d,
            h: h,
            p: p
        }
    }

    compose {
        adversary: {
            GETAOUT: LayerMap,
            SETBIT: LayerMap,
            GBLG: LayerMap,
            GETKEYSIN: LayerMap,
        }
        LayerMap: {
            LSETBIT: KeysFilter,
            LGETAOUT: KeysFilter,
            LGETKEYSIN: KeysFilter,
            GBLG: Gate,
            LSIMGBLG: LayeredSim,
            LGATEGBLG: LayeredGate,
        }
        KeysFilter: {
            SETBIT: KeysTop,
            GETAOUT: KeysTop,
            GETKEYSIN: KeysBot,
            LSETBIT: LayeredKeys,
            LGETAOUT: LayeredKeys,
            LGETKEYSIN: LayeredKeys,
            LGETAIN: LayeredKeys,
            LGETINAIN: LayeredKeys,
            LGETKEYSOUT: LayeredKeys,
            LGETBIT: LayeredKeys,
        }
        Gate: {
            SETBIT: KeysBot,
            ENCN: Enc,
            ENCM: Enc,
            GETKEYSOUT: KeysBot,
        }
        Enc: {
            GETKEYSIN: KeysTop,
        }
        LayeredGate: {
            LSETBIT: KeysFilter,
            LENCN: LayeredEnc0,
            LENCM: LayeredEnc0,
            LGETKEYSOUT: KeysFilter,
        }
        LayeredEnc0: {
            LGETKEYSIN: KeysFilter,
        }
        LayeredSim: {
            LEVAL: LayeredLev,
            LGETAIN: KeysFilter,
            LGETINAIN: KeysFilter,
            LGETAOUT: KeysFilter,
        }
        LayeredLev: {
            LGETBIT: KeysFilter,
            LSETBIT: KeysFilter,
        }
    }
}
