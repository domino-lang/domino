composition CoreReal {
    const n: Integer;
    const p: Integer;
    const m: Integer;
    const d: Integer;
    const encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance Keys = LayeredKeys {
        params {
            n: n,
        }
    }

    instance Enc = LayeredEnc0 {
        params {
            n: n,
            m: m,
            p: p,
            encn: encn,
            encm: encm,
        }
    }

    instance Gate = LayeredGate {
        params {
            p: p,
            n: n,
            m: m,
        }
    }

    instance LayerMap = LayerMap {
        params {
            n: n,
            d: d,
            p: p
        }
    }

    compose {
        adversary: {
            GenerateInputWireKeys: LayerMap,
            GetInputWireKey: LayerMap,
            SetInputBit: LayerMap,
            GarbleGate: LayerMap,
            GetOutputWireKeys: LayerMap,
        }
        LayerMap: {
            SetActiveBit: Keys,
            GenerateWireKeys: Keys,
            GetActiveWireKey: Keys,
            GetWireKeys: Keys,
            GarbleGate: Gate,
        }
        Gate: {
            SetInputBit: SetActiveBit of Keys,
            GenerateWireKeys: Keys,
            GetWireKeys: Keys,
            EncInner: Enc,
            EncOuter: Enc,
        }
        Enc: {
            GetWireKeys: Keys,
        }
    }
}
