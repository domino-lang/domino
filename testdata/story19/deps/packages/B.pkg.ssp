package B {
    state {
        ctr: Integer,
    }

    oracle Branch(x: Integer) -> Integer {
        if (x > 0) {
            r <- 1;
        } else {
            r <- 2;
        }
        return r;
    }

    oracle AbortDiff(b: Bool) -> Integer {
        return 1;
    }

    oracle AbortBoth(b: Bool) -> Integer {
        assert b;
        return 1;
    }

    oracle Admitted(x: Integer) -> Integer {
        return x;
    }
}
