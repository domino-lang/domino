package TwocpaReduction {
    /*
     * Reduction from the two-key game (Twocpa) to multi-instance CPA: the active
     * key of a wire is held by the reduction itself, the inactive (secret) one by
     * the CPA game.
     */
    params {
        n: Integer,
        m: Integer,
        p: Integer,
        enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    import oracles {
        SampleKey(h: Integer),
        LR_EncInner(h: Integer, left: Bits(n), right: Bits(n)) -> Bits(m),
        LR_EncOuter(h: Integer, left: Bits(m), right: Bits(m)) -> Bits(p),
    }

    state {
        ActiveBit: Table(Integer, Bool),
        ActiveKey: Table(Integer, Bits(n)),
        Generated: Table(Integer, Bool),
    }

    oracle SetActiveBit(wire: Integer, bit: Bool) {
        assert (ActiveBit[wire] == None);
        ActiveBit[wire] <- Some(bit);
        return;
    }

    oracle GenerateWireKeys(wire: Integer) {
        /* mirrors Keys: the bit is fixed before the keys are generated */
        assert (ActiveBit[wire] != None);
        if (Generated[wire] != Some(true)) {
            invoke SampleKey(wire);
            active_key <-$ Bits(n) sample-name active_key;
            ActiveKey[wire] <- Some(active_key);
            Generated[wire] <- Some(true);
        }
    }

    oracle GetActiveWireKey(wire: Integer) -> Bits(n) {
        assert (ActiveBit[wire] != None);
        key <- Unwrap(ActiveKey[wire]);
        return key;
    }

    oracle EncInner(wire: Integer, bit: Bool, msg: Bits(n)) -> Bits(m) {
        assert (Generated[wire] == Some(true));
        active <- Unwrap(ActiveBit[wire]);
        if (bit == active) {
            key <- Unwrap(ActiveKey[wire]);
            r <-$ Bits(n) sample-name r;
            c <- enc_inner(key, msg, r);
        } else {
            /* real-or-zeros: the secret key encrypts zeros in the ideal game */
            c <- invoke LR_EncInner(wire, msg, 0_n);
        }
        return c;
    }

    oracle EncOuter(wire: Integer, bit: Bool, msg: Bits(m)) -> Bits(p) {
        assert (Generated[wire] == Some(true));
        active <- Unwrap(ActiveBit[wire]);
        if (bit == active) {
            key <- Unwrap(ActiveKey[wire]);
            r <-$ Bits(n) sample-name r;
            c <- enc_outer(key, msg, r);
        } else {
            /* real-or-zeros: the secret key encrypts zeros in the ideal game */
            c <- invoke LR_EncOuter(wire, msg, 0_m);
        }
        return c;
    }
}
