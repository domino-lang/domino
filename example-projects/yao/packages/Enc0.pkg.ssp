package Enc0 {
    /*
     * Real encryption of the 2CPA game: every message is encrypted as given,
     * under the key selected by the bit b.
     */
    params {
        n: Integer,
        m: Integer,
        p: Integer,
        encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    import oracles {
        GETKEYSIN(h: Integer) -> Table(Bool, Bits(n)),
    }


    oracle ENCN(j: Integer, b: Bool, msg: Bits(n)) -> Bits(m) {
        K <- invoke GETKEYSIN(j);
        r <-$ Bits(n) sample-name r;
        c <- encn(Unwrap(K[b]), msg, r);
        return c;
    }

    oracle ENCM(j: Integer, b: Bool, msg: Bits(m)) -> Bits(p) {
        K <- invoke GETKEYSIN(j);
        r <-$ Bits(n) sample-name r;
        c <- encm(Unwrap(K[b]), msg, r);
        return c;
    }
}
