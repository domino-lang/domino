package Keys {
    params {
        n: Integer,
    }

    state {
        WireKey: Table(Integer, Table(Bool, Bits(n))),
        ActiveBit: Table(Integer, Bool),
    }


    oracle GETKEYSIN(h: Integer) -> Table(Bool, Bits(n)) {
        assert (ActiveBit[h] != None);
        W <- Unwrap(WireKey[h]);
        return W;
    }

    oracle GETAIN(h: Integer) -> Bits(n) {
        W <- Unwrap(WireKey[h]);
        a <- Unwrap(ActiveBit[h]);
        k <- Unwrap(W[a]);
        return k;
    }

    oracle GETINAIN(h: Integer) -> Bits(n) {
        W <- Unwrap(WireKey[h]);
        a <- Unwrap(ActiveBit[h]);
        k <- Unwrap(W[not a]);
        return k;
    }

    oracle GETAOUT(h: Integer) -> Bits(n) {
        W <- new Table(Bool, Bits(n));
        if (WireKey[h] == None) {
            r <-$ Bits(n) sample-name r;
            W[true] <- Some(r);
            rr <-$ Bits(n) sample-name rr;
            W[false] <- Some(rr);
            WireKey[h] <- Some(W);
        }
        W <- Unwrap(WireKey[h]);
        a <- Unwrap(ActiveBit[h]);
        k <- Unwrap(W[a]);
        return k;
    }

    oracle GETKEYSOUT(h: Integer) -> Table(Bool, Bits(n)) {
        W <- new Table(Bool, Bits(n));
        if (WireKey[h] == None) {
            r <-$ Bits(n) sample-name r;
            W[true] <- Some(r);
            rr <-$ Bits(n) sample-name rr;
            W[false] <- Some(rr);
            WireKey[h] <- Some(W);
        }
        W <- Unwrap(WireKey[h]);
        return W;
    }

    oracle GETBIT(h: Integer) -> Bool {
        assert (ActiveBit[h] != None as Bool);
        a <- Unwrap(ActiveBit[h]);
        return a;
    }

    oracle SETBIT(h: Integer, a: Bool) {
        assert (ActiveBit[h] == None as Bool);
        ActiveBit[h] <- Some(a);
        return;
    }
}
