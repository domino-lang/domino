composition TwocpaViaCpa1 {
    const n: Integer;
    const m: Integer;
    const p: Integer;
    const enc_inner: fn Bits(n),Bits(n),Bits(n) -> Bits(m);
    const enc_outer: fn Bits(n),Bits(m),Bits(n) -> Bits(p);

    instance cpa = MultiInstanceCpa {
        params {
            b: true,
            n: n,
            m: m,
            p: p,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    instance reduction = TwocpaReduction {
        params {
            n: n,
            m: m,
            p: p,
            enc_inner: enc_inner,
            enc_outer: enc_outer,
        }
    }

    compose {
        reduction: {
            SampleKey: cpa,
            LR_EncInner: EncInner of cpa,
            LR_EncOuter: EncOuter of cpa,
        }
        adversary: {
            GenerateInputWireKeys: GenerateWireKeys of reduction,
            GetInputWireKey: GetActiveWireKey of reduction,
            SetInputBit: SetActiveBit of reduction,
            EncInner: reduction,
            EncOuter: reduction,
        }
    }
}
