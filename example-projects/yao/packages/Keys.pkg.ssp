package Keys {
    params {
        n: Integer,
    }

    state {
        WireKey: Table(Integer, Table(Bool, Bits(n))),
        ActiveBit: Table(Integer, Bool),
    }


    oracle SetActiveBit(wire: Integer, bit: Bool) {
        assert (ActiveBit[wire] == None);
        ActiveBit[wire] <- Some(bit);
        return;
    }

    oracle GetActiveBit(wire: Integer) -> Bool {
        assert (ActiveBit[wire] != None);
        b <- Unwrap(ActiveBit[wire]);
        return b;
    }

    oracle GenerateWireKeys(wire: Integer) {
        /* Enforcing wire key generation after setting input is not necessary 
        but makes reduction to CPA easier as we can know which key should be 
        stored in CPA game and which in reduction */
        assert (ActiveBit[wire] != None);
        if (WireKey[wire] == None) {
            W <- new Table(Bool, Bits(n));
            k1 <-$ Bits(n) sample-name key_true;
            W[true] <- Some(k1);
            k0 <-$ Bits(n) sample-name key_false;
            W[false] <- Some(k0);
            WireKey[wire] <- Some(W);
        }
    }

    oracle GetWireKeys(wire: Integer) -> Table(Bool, Bits(n)) {
        /* Real garbler sets a dummy active bit for output keys. Simulator 
        sets the true active bit due to gate evaluation */
        assert (ActiveBit[wire] != None);
        W <- Unwrap(WireKey[wire]);
        return W;
    }

    oracle GetActiveWireKey(wire: Integer) -> Bits(n) {
        W <- Unwrap(WireKey[wire]);
        b <- Unwrap(ActiveBit[wire]);
        k <- Unwrap(W[b]);
        return k;
    }

    oracle GetInactiveWireKey(wire: Integer) -> Bits(n) {
        W <- Unwrap(WireKey[wire]);
        b <- Unwrap(ActiveBit[wire]);
        k <- Unwrap(W[not b]);
        return k;
    }
}
