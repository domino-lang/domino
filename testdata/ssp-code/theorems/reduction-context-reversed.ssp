theorem Diagnostic {
    instance a0 = AssumptionGame {}
    instance a1 = AssumptionGame {}
    instance c0 = RightGame {}
    instance c1 = LeftGame {}
    assumptions { Basic: a0 ~ a1 }
    gamehops {
        reduction c0 c1 {
            assumption Basic
            map a0 c0 { leaf: leaf }
            map a1 c1 { leaf: leaf }
        }
    }
}
