package LayeredGate {
    /* layered mirror of Gate */
    params {
        n: Integer,
        m: Integer,
        p: Integer,
    }

    import oracles {
        SetInputBit(layer: Integer, wire: Integer, bit: Bool),
        GenerateWireKeys(layer: Integer, wire: Integer),
        GetWireKeys(layer: Integer, wire: Integer) -> Table(Bool, Bits(n)),
        EncInner(layer: Integer, wire: Integer, bit: Bool, msg: Bits(n)) -> Bits(m),
        EncOuter(layer: Integer, wire: Integer, bit: Bool, msg: Bits(m)) -> Bits(p),
    }

    oracle GarbleGate(
        layer: Integer,
        left_input: Integer,
        right_input: Integer,
        gate: Table((Bool, Bool), Bool),
        output: Integer
    ) -> Table(Bits(p), Bool) {
        invoke SetInputBit((layer + 1), output, false);
        C <- new Table(Bits(p), Bool);
        invoke GenerateWireKeys((layer + 1), output);
        Z <- invoke GetWireKeys((layer + 1), output);
        bl <- false;
        br <- false;
        bj <- Unwrap(gate[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke EncInner(layer, left_input, bl, kj);
        cout <- invoke EncOuter(layer, right_input, br, cin);
        C[cout] <- Some(true);
        bl <- true;
        br <- false;
        bj <- Unwrap(gate[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke EncInner(layer, left_input, bl, kj);
        cout <- invoke EncOuter(layer, right_input, br, cin);
        C[cout] <- Some(true);
        bl <- false;
        br <- true;
        bj <- Unwrap(gate[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke EncInner(layer, left_input, bl, kj);
        cout <- invoke EncOuter(layer, right_input, br, cin);
        C[cout] <- Some(true);
        bl <- true;
        br <- true;
        bj <- Unwrap(gate[(bl, br)]);
        kj <- Unwrap(Z[bj]);
        cin <- invoke EncInner(layer, left_input, bl, kj);
        cout <- invoke EncOuter(layer, right_input, br, cin);
        C[cout] <- Some(true);
        return C;
    }
}
