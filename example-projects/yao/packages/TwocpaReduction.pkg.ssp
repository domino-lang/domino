package TwocpaReduction {
    params {
        n: Integer,
        m: Integer,
        p: Integer,
        encn: fn Bits(n),Bits(n),Bits(n) -> Bits(m),
        encm: fn Bits(n),Bits(m),Bits(n) -> Bits(p),
    }

    state {
        ActiveBit: Table(Integer, Bool),
        ActiveKey: Table(Integer, Bits(n)),
        Initialized: Table(Integer, Bool),
    }

    import oracles {
        SAMPLEKEY(h: Integer),
        LR_ENCN(h: Integer, left: Bits(n), right: Bits(n)) -> Bits(m),
        LR_ENCM(h: Integer, left: Bits(m), right: Bits(m)) -> Bits(p),
    }

    oracle SETBIT(h: Integer, a: Bool) {
        assert (ActiveBit[h] == None as Bool);
        ActiveBit[h] <- Some(a);
        return;
    }

    oracle GETAOUT(h: Integer) -> Bits(n) {
        assert (ActiveBit[h] != None as Bool);
        if (Initialized[h] != Some(true)) {
            k <-$ Bits(n) sample-name k;
            ActiveKey[h] <- Some(k);
            invoke SAMPLEKEY(h);
            Initialized[h] <- Some(true);
        }
        k <- Unwrap(ActiveKey[h]);
        return k;
    }

    oracle ENCN(h: Integer, d: Bool, left: Bits(n), right: Bits(n)) -> Bits(m) {
        assert (Initialized[h] == Some(true));
        a <- Unwrap(ActiveBit[h]);
        if (d == a) {
            k <- Unwrap(ActiveKey[h]);
            r <-$ Bits(n) sample-name r;
            c <- encn(k, left, r);
        } else {
            c <- invoke LR_ENCN(h, left, right);
        }
        return c;
    }

    oracle ENCM(h: Integer, d: Bool, left: Bits(m), right: Bits(m)) -> Bits(p) {
        assert (Initialized[h] == Some(true));
        a <- Unwrap(ActiveBit[h]);
        if (d == a) {
            k <- Unwrap(ActiveKey[h]);
            r <-$ Bits(n) sample-name r;
            c <- encm(k, left, r);
        } else {
            c <- invoke LR_ENCM(h, left, right);
        }
        return c;
    }
}
