composition AssumptionIdealWeak {
    const n: Integer;
    const prf: fn Bits(n), Bits(n) -> Bits(n);
    
    instance Prf = PRF {
        params {
            n:   n,
            prf: prf,
        }
    }
    
    instance key = KeyIdeal {
        params {
            n: n,
        }
    }
    
    compose {
        adversary: {
            Eval: Prf,
        },
        Prf: {
            Set: key,
        },
    }
}
