package HybridLayerMap {
    /*
     * Same as LayerMap, except that GarbleGate dispatches on the gate layer:
     *
     *   layer <  h  -> already simulated         (LayeredSim)
     *   layer == h  -> handled by the assumption (Gate / Simgate of LayerReal / LayerIdeal)
     *   layer >  h  -> still real                (LayeredGate)
     *
     * The key oracles need no special casing any more: they go to KeysFilter,
     * which routes wire layers h and (h + 1) to the assumption. For h = 0 every
     * gate layer is real and for h = d every valid gate layer is simulated, so this
     * package degenerates to LayerMap composed with the real resp. simulated side.
     * Since theorem parameters cannot currently contain `d + 1`, h = d is used as
     * the all-simulated sentinel; assumption layers are therefore restricted to
     * 0 < h < d.
     */

    params {
        h: Integer, /* hybrid parameter */
        n: Integer,
        d: Integer, /* number of gate layers of the circuit */
        p: Integer,
    }

    import oracles {
        SetActiveBit(layer: Integer, wire: Integer, bit: Bool),
        GenerateWireKeys(layer: Integer, wire: Integer),
        GetActiveWireKey(layer: Integer, wire: Integer) -> Bits(n),
        GetWireKeys(layer: Integer, wire: Integer) -> Table(Bool, Bits(n)),

        /* the assumption's garbling oracle, for gate layer h */
        Assumption(
            left_input: Integer,
            right_input: Integer,
            gate: Table((Bool, Bool), Bool),
            output: Integer
        ) -> Table(Bits(p), Bool),

        /* the simulated gate layers 1..(h - 1) */
        SimulateGarbledGate(
            layer: Integer,
            left_input: Integer,
            right_input: Integer,
            gate: Table((Bool, Bool), Bool),
            output: Integer
        ) -> Table(Bits(p), Bool),

        /* the real gate layers (h + 1)..d */
        GarbleGate(
            layer: Integer,
            left_input: Integer,
            right_input: Integer,
            gate: Table((Bool, Bool), Bool),
            output: Integer
        ) -> Table(Bits(p), Bool),
    }

    oracle SetInputBit(wire: Integer, bit: Bool) {
        assert (d > 0);
        invoke SetActiveBit(1, wire, bit);
    }

    oracle GenerateInputWireKeys(wire: Integer) {
        assert (d > 0);
        invoke GenerateWireKeys(1, wire);
    }

    oracle GetInputWireKey(wire: Integer) -> Bits(n) {
        assert (d > 0);
        k <- invoke GetActiveWireKey(1, wire);
        return k;
    }

    oracle GetOutputWireKeys(wire: Integer) -> Table(Bool, Bits(n)) {
        assert (d > 0);
        T <- invoke GetWireKeys((d + 1), wire);
        return T;
    }

    oracle GarbleGate( /* garble gate `output` in gate layer `layer` */
        layer: Integer,
        left_input: Integer,
        right_input: Integer,
        gate: Table((Bool, Bool), Bool),
        output: Integer) -> Table(Bits(p), Bool)
    {
        assert (layer >= 1);
        assert (layer <= d);
        if ((h == d) or (layer < h)) {
            C <- invoke SimulateGarbledGate(layer, left_input, right_input, gate, output);
            return C;
        }
        if (layer > h) {
            C <- invoke GarbleGate(layer, left_input, right_input, gate, output);
            return C;
        }
        assert (layer == h);
        C <- invoke Assumption(left_input, right_input, gate, output);
        return C;
    }
}
