theorem A {
    const foo: fn Integer -> Integer;

    instance A = A {
        params {
            foo: foo
        }
    }
    instance B = A {
        params {
            foo: foo
        }
    }

    gamehops {
        equivalence A B {
            invariant: ./theorem/invariant.smt2

            Test: {
                randomness: none
            }
        }
    }
}
