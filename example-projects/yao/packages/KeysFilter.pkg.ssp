package KeysFilter {
    /*
     * KeysFilter sits between every layered consumer (LayerMap, LayeredGate,
     * LayeredEnc0, LayeredSim, LayeredEval) and the *single* merged LayeredKeys
     * instance of a hybrid game.
     *
     * Wire layers are numbered 1..(d + 1): the gates of gate layer i read the wire
     * keys of wire layer i and write the wire keys of wire layer (i + 1).
     *
     * In the h-th hybrid, gate layer h is handled by the assumption (LayerReal /
     * LayerIdeal), so its two key packages own two wire layers:
     *
     *   wire layer h       -> KeysTop  (the assumption's keys_top)
     *   wire layer (h + 1) -> KeysBot  (the assumption's keys_bottom)
     *   every other layer  -> LayeredKeys (merged, shared by simulated and real layers)
     *
     * The assumption only exports SetActiveBit/GenerateWireKeys/GetActiveWireKey on
     * keys_top and GetWireKeys on keys_bottom, and those are exactly the accesses
     * that reach across the assumption boundary:
     *
     *   SetActiveBit(h, .)       from LayerMap (h == 1) or LayeredEval (gate layer h - 1)
     *   GenerateWireKeys(h, .)   from LayerMap (h == 1) or LayeredSim (gate layer h - 1)
     *   GetActiveWireKey(h, .)   from LayerMap (h == 1) or LayeredSim (gate layer h - 1)
     *   GetWireKeys(h + 1, .)    from LayeredEnc0 (gate layer h + 1) or LayerMap (h == d)
     *
     * All other oracles never see wire layer h or h + 1 and are plain forwards.
     *
     * The redirection is guarded by 0 < h < d, so that h outside that range makes
     * this package a pure forwarder: h = 0 is the all-real game (CoreReal) and
     * h = d is the all-simulated game (CoreIdeal), with the assumption
     * packages left dangling.
     */

    params {
        n: Integer,
        h: Integer, /* hybrid parameter: the gate layer served by the assumption */
        d: Integer, /* number of gate layers of the circuit */
    }

    import oracles {
        /* assumption, top wires: wire layer h */
        TopSetActiveBit(wire: Integer, bit: Bool),
        TopGenerateWireKeys(wire: Integer),
        TopGetActiveWireKey(wire: Integer) -> Bits(n),

        /* assumption, bottom wires: wire layer (h + 1) */
        BotGetWireKeys(wire: Integer) -> Table(Bool, Bits(n)),

        /* merged layered keys: every other wire layer */
        SetActiveBit(layer: Integer, wire: Integer, bit: Bool),
        GetActiveBit(layer: Integer, wire: Integer) -> Bool,
        GenerateWireKeys(layer: Integer, wire: Integer),
        GetWireKeys(layer: Integer, wire: Integer) -> Table(Bool, Bits(n)),
        GetActiveWireKey(layer: Integer, wire: Integer) -> Bits(n),
        GetInactiveWireKey(layer: Integer, wire: Integer) -> Bits(n),
    }

    oracle SetActiveBit(layer: Integer, wire: Integer, bit: Bool) {
        if ((h > 0) and (h < d) and (layer == h)) {
            invoke TopSetActiveBit(wire, bit);
        } else {
            invoke SetActiveBit(layer, wire, bit);
        }
        return;
    }

    oracle GenerateWireKeys(layer: Integer, wire: Integer) {
        if ((h > 0) and (h < d) and (layer == h)) {
            invoke TopGenerateWireKeys(wire);
        } else {
            invoke GenerateWireKeys(layer, wire);
        }
        return;
    }

    oracle GetActiveWireKey(layer: Integer, wire: Integer) -> Bits(n) {
        if ((h > 0) and (h < d) and (layer == h)) {
            k <- invoke TopGetActiveWireKey(wire);
        } else {
            k <- invoke GetActiveWireKey(layer, wire);
        }
        return k;
    }

    oracle GetWireKeys(layer: Integer, wire: Integer) -> Table(Bool, Bits(n)) {
        if ((h > 0) and (h < d) and (layer == (h + 1))) {
            Z <- invoke BotGetWireKeys(wire);
        } else {
            Z <- invoke GetWireKeys(layer, wire);
        }
        return Z;
    }

    /* the oracles below are never called on wire layer h or (h + 1) */

    oracle GetInactiveWireKey(layer: Integer, wire: Integer) -> Bits(n) {
        k <- invoke GetInactiveWireKey(layer, wire);
        return k;
    }

    oracle GetActiveBit(layer: Integer, wire: Integer) -> Bool {
        b <- invoke GetActiveBit(layer, wire);
        return b;
    }
}
